# Copy to .env next to server.js (git-ignored) and fill in. Restart the app after changes.
# xCloud sets PORT for you; keep HOST=127.0.0.1 so only its Nginx proxy reaches the app.
PORT=3000
HOST=127.0.0.1

# Review page password hash: run `npm run hash-password` and paste the line it prints.
ADMIN_PASSWORD_HASH=
# Long random string: run `npm run secret` and paste the line it prints.
SECRET=

# Where submitted GIFs and db.json are stored. Defaults to ~/library-data (the site user's home), which is
# outside the app folder, so deploys never touch it. Only set this to move it somewhere the site user can write.
# DATA_DIR=/home/SITEUSER/library-data

# Largest accepted GIF/WebP (also the largest GIF a converted video may produce).
MAX_UPLOAD_MB=8

# Short video uploads (MP4, MOV, WebM, MKV, AVI) are converted to an animated WebP (or GIF) with ffmpeg.
# When none is installed, the app downloads a static ffmpeg into ~/.cache/game-animation-library in the background
# after it starts, or install it with `sudo apt install ffmpeg` (see DEPLOY-XCLOUD.md). Set Nginx client_max_body_size a bit above VIDEO_MAX_MB.
VIDEO_MAX_MB=25
VIDEO_MAX_SECONDS=10
# Longest side of the converted GIF in pixels, and its frame rate (a too-large result is retried at 320 px / 10 fps).
VIDEO_SIZE=480
VIDEO_FPS=15
# FFMPEG_PATH=/usr/bin/ffmpeg
# Set to 0 to stop the app downloading ffmpeg at startup when none is found.
# AUTO_INSTALL_FFMPEG=1
VOTES_PER_HOUR=300
SUBMISSIONS_PER_HOUR=10

# A library GIF is flagged for a replacement search once it has this many downvotes and is this far below its upvotes.
FLAG_MIN_DOWNVOTES=3
FLAG_NET_SCORE=2

# Optional replacement search for flagged GIFs (free keys from developers.giphy.com and Google Cloud's Tenor API).
GIPHY_API_KEY=
TENOR_API_KEY=
SEARCH_EVERY_MINUTES=60

# Let the GitHub Pages copy use this API too (comma-separated origins).
# ALLOWED_ORIGINS=https://atomechllc.github.io
